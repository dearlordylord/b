def sum3(a: Nat, b: Nat, c: Nat) -> Nat:
  Nat.add(Nat.add(a, b), c)
def coord_weighted_row(+w: Nat, +a: Nat, +b: Nat, +c: Nat) -> {Nat.mul(w, sum3(a, b, c)) == sum3(Nat.mul(w, a), Nat.mul(w, b), Nat.mul(w, c)) : Nat}:
  Equal.trans(Nat, Nat.mul(w, sum3(a, b, c)), Nat.add(Nat.mul(w, Nat.add(a, b)), Nat.mul(w, c)), sum3(Nat.mul(w, a), Nat.mul(w, b), Nat.mul(w, c)), F.mul_add(w, Nat.add(a, b), c), Equal.cong(Nat, Nat, n => Nat.add(n, Nat.mul(w, c)), Nat.mul(w, Nat.add(a, b)), Nat.add(Nat.mul(w, a), Nat.mul(w, b)), F.mul_add(w, a, b)))
def coord_row_columns(+w: Nat, +a: Nat, +b: Nat, +c: Nat, +d: Nat, +y: Nat, +x: Nat, +e: Nat) -> {Nat.mul(w, sum3(Nat.mul(Nat.mul(a, b), d), Nat.mul(c, y), Nat.mul(x, e))) == sum3(Nat.mul(Nat.mul(w, Nat.mul(a, b)), d), Nat.mul(Nat.mul(w, c), y), Nat.mul(Nat.mul(w, e), x)) : Nat}:
  Equal.trans(Nat, Nat.mul(w, sum3(Nat.mul(Nat.mul(a, b), d), Nat.mul(c, y), Nat.mul(x, e))), sum3(Nat.mul(w, Nat.mul(Nat.mul(a, b), d)), Nat.mul(w, Nat.mul(c, y)), Nat.mul(w, Nat.mul(x, e))), sum3(Nat.mul(Nat.mul(w, Nat.mul(a, b)), d), Nat.mul(Nat.mul(w, c), y), Nat.mul(Nat.mul(w, e), x)), coord_weighted_row(w, Nat.mul(Nat.mul(a, b), d), Nat.mul(c, y), Nat.mul(x, e)), GP.sum3_cong(Nat.mul(w, Nat.mul(Nat.mul(a, b), d)), Nat.mul(w, Nat.mul(c, y)), Nat.mul(w, Nat.mul(x, e)), Nat.mul(Nat.mul(w, Nat.mul(a, b)), d), Nat.mul(Nat.mul(w, c), y), Nat.mul(Nat.mul(w, e), x), Equal.sym(Nat, Nat.mul(Nat.mul(w, Nat.mul(a, b)), d), Nat.mul(w, Nat.mul(Nat.mul(a, b), d)), F.mul_assoc(w, Nat.mul(a, b), d)), Equal.sym(Nat, Nat.mul(Nat.mul(w, c), y), Nat.mul(w, Nat.mul(c, y)), F.mul_assoc(w, c, y)), CP.reordered_product(w, x, e)))
