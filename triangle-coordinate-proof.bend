def L.reconstructed_point_exact(a, b, c, p, ht, h):
  match p:
    case G.P{x, y, d}: coord_reconstruct_fields(a, b, c, x, y, d, ht, h)
def coord_cross_scale(+x: Nat, +d: Nat, +t: Nat) -> {Nat.mul(x, Nat.mul(d, t)) == Nat.mul(Nat.mul(x, t), d) : Nat}:
