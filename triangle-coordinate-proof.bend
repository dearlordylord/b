def L.positive_coordinate_cycle(a, b, c, p, axis):
  match a b c p axis:
    case N.P{ax, ay} N.P{bx, by} N.P{cx, cy} G.P{x, y, d} False{}: coord_x_positive_fields(ax, ay, bx, by, cx, cy, x, y, d)
    case N.P{ax, ay} N.P{bx, by} N.P{cx, cy} G.P{x, y, d} True{}: coord_y_positive_fields(ax, ay, bx, by, cx, cy, x, y, d)

def L.negative_coordinate_cycle(a, b, c, p, axis):
  match a b c p axis:
    case N.P{ax, ay} N.P{bx, by} N.P{cx, cy} G.P{x, y, d} False{}: coord_x_negative_fields(ax, ay, bx, by, cx, cy, x, y, d)
    case N.P{ax, ay} N.P{bx, by} N.P{cx, cy} G.P{x, y, d} True{}: coord_y_negative_fields(ax, ay, bx, by, cx, cy, x, y, d)

