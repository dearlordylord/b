def coord_cycle_recover(+a: N.Point, +b: N.Point, +c: N.Point, +p: G.Point, +axis: Bool, h: {D.triangle(a, b, c, p) == True{} : Bool}) -> {Nat.add(M.weighted(a, b, c, p, axis), Nat.add(Nat.mul(A.negative(a, b, Q.embed(c)), M.point_coordinate(p, axis)), M.common(a, b, c, p, axis))) == Nat.add(Nat.mul(A.positive(a, b, Q.embed(c)), M.point_coordinate(p, axis)), M.common(a, b, c, p, axis)) : Nat}:
  %L.negative_coordinate_cycle(a, b, c, p, axis) : {Nat.add(M.weighted(a, b, c, p, axis), _) == Nat.add(Nat.mul(A.positive(a, b, Q.embed(c)), M.point_coordinate(p, axis)), M.common(a, b, c, p, axis)) : Nat}
  %L.positive_coordinate_cycle(a, b, c, p, axis) : {Nat.add(M.weighted(a, b, c, p, axis), M.negative_weighted(a, b, c, p, axis)) == _ : Nat}
  coord_sum_reconstruct(a, b, c, p, axis, Fields.three_fields(Region.edge(a, b, p), Region.edge(b, c, p), Region.edge(c, a, p), h))
def L.weighted_coordinate_exact(a, b, c, p, axis, ht, h):
  AP.area_cancel_weights(M.weighted(a, b, c, p, axis), A.positive(a, b, Q.embed(c)), A.negative(a, b, Q.embed(c)), M.common(a, b, c, p, axis), A.triangle_area(a, b, c), M.point_coordinate(p, axis), coord_cycle_recover(a, b, c, p, axis, h), AL.area_reconstruct(a, b, Q.embed(c), QP.edge_turn(a, b, c, ht)))
