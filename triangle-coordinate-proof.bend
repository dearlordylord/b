  match p:
    case G.P{+x, +y, +d}: B.and_join(Nat.is_eq(Nat.mul(x, Nat.mul(d, t)), Nat.mul(Nat.mul(x, t), d)), Nat.is_eq(Nat.mul(y, Nat.mul(d, t)), Nat.mul(Nat.mul(y, t), d)), Reflection.nat_eq_complete(Nat.mul(x, Nat.mul(d, t)), Nat.mul(Nat.mul(x, t), d), coord_cross_scale(x, d, t)), Reflection.nat_eq_complete(Nat.mul(y, Nat.mul(d, t)), Nat.mul(Nat.mul(y, t), d), coord_cross_scale(y, d, t)))
