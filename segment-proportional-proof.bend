def equivalent_fields(+x:Nat,+y:Nat,+d:Nat,+u:Nat,+z:Nat,+e:Nat,+k:Nat,+l:Nat,+v:Nat,+w:Nat,+h:{Nat.mul(k,w) == Nat.mul(l,v) : Nat}) -> {G.equivalent(C.join(G.P{x,y,d},G.P{u,z,e},k,l),C.join(G.P{x,y,d},G.P{u,z,e},v,w)) == True{} : Bool}:
