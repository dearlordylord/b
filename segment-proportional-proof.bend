def add_cong(+a:Nat,+b:Nat,+c:Nat,+d:Nat,ha:{a == c : Nat},hb:{b == d : Nat}) -> {Nat.add(a,b) == Nat.add(c,d) : Nat}:
  %ha : {Nat.add(a,b) == Nat.add(_,d) : Nat}
  %hb : {Nat.add(a,b) == Nat.add(a,_) : Nat}
  {==}
